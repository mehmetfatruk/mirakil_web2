---
interface Item { icon: string | null; title: string; text: string | null }
interface Props {
  id?: string | null;
  title: string;
  intro?: string;
  paragraphs?: string[];
  badges?: string[];
  items: Item[];
}
const { id, title, intro, paragraphs, badges, items } = Astro.props;
---
<section class="section" id={id ?? 'why'}>
  <div class="container why">
    <div class="why-head reveal">
      <h2>{title}</h2>
      {intro && <p>{intro}</p>}
      {paragraphs?.map((p) => <p set:html={p} />)}
      {badges && badges.length > 0 && (
        <ul role="list" class="why-badges">
          {badges.map((b) => <li><i class="fas fa-check" aria-hidden="true"></i>{b}</li>)}
        </ul>
      )}
    </div>
    <ol role="list" class="why-list reveal-stagger">
      {items.map((w) => (
        <li class="why-item">
          <span class="icon-tile"><i class={w.icon ?? 'fas fa-check'} aria-hidden="true"></i></span>
          <div>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .why { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--sp-8); align-items: start; }
  .why-head { position: sticky; top: calc(var(--nav-h) + var(--sp-6)); }
  .why-head h2 { font-size: var(--fs-display-md); font-weight: 800; line-height: 1.15; letter-spacing: -0.015em; }
  .why-head h2::after { content: ''; display: block; width: 56px; height: 4px; margin-top: var(--sp-4); border-radius: var(--r-pill); background: var(--brand); }
  .why-head p { margin-top: var(--sp-4); color: var(--ink-muted); font-size: var(--fs-body-lg); line-height: 1.6; }
  .why-head p + p { font-size: var(--fs-body); }
  .why-badges { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-top: var(--sp-5); }
  .why-badges li { display: inline-flex; align-items: center; gap: var(--sp-2); padding: 6px 14px; border-radius: var(--r-pill); font-size: var(--fs-body-sm); font-weight: 600; background: var(--brand-tint); color: var(--brand-pressed); }
  .why-badges i { font-size: 0.7rem; }
  .why-list { display: grid; gap: var(--sp-3); }
  .why-item { display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: var(--sp-5); padding: var(--sp-5); border-radius: var(--r-md); background: var(--surface-1); transition: background-color var(--dur), transform var(--dur) var(--ease-out); }
  .why-item:hover { background: var(--brand-tint); transform: translateX(6px); }
  .why-item h3 { font-size: var(--fs-card-title); font-weight: 700; line-height: 1.3; }
  .why-item p { margin-top: var(--sp-2); color: var(--ink-muted); line-height: 1.65; }
  .why-item:hover :global(.icon-tile) { background: var(--brand); color: var(--on-brand); }
  @media (max-width: 959px) {
    .why { grid-template-columns: 1fr; gap: var(--sp-6); }
    .why-head { position: static; }
  }
</style>

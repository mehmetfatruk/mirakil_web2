---
import { url, company, productsInNavOrder, facts, type NavKey } from '../lib/site';

interface Props { active: NavKey; contactHref: string }
const { active, contactHref } = Astro.props;
const onHome = active === 'home';
const home = (hash: string) => (onHome ? hash : url('index.html' + hash));
---
<div class="utility-bar">
  <div class="container utility-inner">
    <span class="utility-note">Müze, arşiv ve kütüphane yönetim çözümleri</span>
    <div class="utility-links">
      <a href={company.phoneHref}><i class="fas fa-phone" aria-hidden="true"></i> {company.phone}</a>
      <a href={company.emailHref}><i class="fas fa-envelope" aria-hidden="true"></i> {company.email}</a>
      <a href={url('destek.html')}><i class="fas fa-headset" aria-hidden="true"></i> Destek</a>
    </div>
  </div>
</div>

<header class="site-nav" data-nav>
  <div class="container nav-inner">
    <div class="nav-brand">
      <a href={url('index.html')} class="nav-logo" aria-label="MirAkıl ana sayfa">
        <img src={url('assets/logo.webp')} alt="MirAkıl Logo" width="184" height="40" />
      </a>
      <!-- Anniversary seal: ring draws in, number counts up, a light sweeps across (see script). -->
      <span class="anniv" role="img" aria-label={`${facts.yearsExperience}. yılımızdayız`} title={`${facts.yearsExperience}. yılımızdayız`} data-anniv>
        <svg class="anniv-ring" viewBox="0 0 100 100" aria-hidden="true">
          <defs>
            <linearGradient id="annivGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#0a8fd6" />
              <stop offset="1" stop-color="#0f4a74" />
            </linearGradient>
          </defs>
          <circle class="anniv-track" cx="50" cy="50" r="45" />
          <circle class="anniv-arc" cx="50" cy="50" r="45" pathLength="1" />
        </svg>
        <span class="anniv-num" aria-hidden="true" data-anniv-num>{facts.yearsExperience}</span>
        <span class="anniv-label" aria-hidden="true">Yıl</span>
      </span>
    </div>

    <nav aria-label="Ana menü" class="nav-menu" id="navMenu">
      <ul role="list">
        <li><a href={url('index.html')} aria-current={onHome ? 'page' : undefined}>Ana Sayfa</a></li>
        <li class="has-dropdown">
          <button type="button" class="nav-dd-toggle" aria-expanded="false" aria-controls="productsMenu" data-active={active === 'products' ? 'true' : undefined}>
            Ürünler <i class="fas fa-chevron-down" aria-hidden="true"></i>
          </button>
          <div class="nav-dropdown" id="productsMenu">
            <ul role="list" class="nav-dd-grid">
              {productsInNavOrder.map((p) => (
                <li>
                  <a href={url(`${p.slug}.html`)}>
                    <span class="dd-logo"><img src={url(p.logo)} alt="" loading="lazy" /></span>
                    <span class="dd-text">
                      <span class="dd-name">{p.name}</span>
                      <span class="dd-sub">{p.category}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
            <a class="link nav-dd-all" href={home('#products')}>Tüm ürünler <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
          </div>
        </li>
        <li><a href={home('#services')}>Hizmetler</a></li>
        <li><a href={home('#why-us')}>Hakkımızda</a></li>
        <li><a href={url('referanslar.html')} aria-current={active === 'references' ? 'page' : undefined}>Referanslar</a></li>
        <li><a href={home('#faq')}>SSS</a></li>
        <li><a href={url('destek.html')} aria-current={active === 'support' ? 'page' : undefined}>Destek</a></li>
        <li><a href={contactHref.startsWith('#') ? contactHref : url(contactHref)} class="btn nav-cta">İletişim</a></li>
      </ul>
    </nav>

    <button type="button" class="nav-toggle" aria-label="Menü" aria-expanded="false" aria-controls="navMenu" data-nav-toggle>
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  .nav-brand { display: flex; align-items: center; gap: var(--sp-4); }
  .anniv {
    position: relative; overflow: hidden; flex: none;
    display: grid; place-content: center; justify-items: center;
    width: 50px; height: 50px; border-radius: 50%;
    background: radial-gradient(circle at 30% 25%, #ffffff, var(--brand-tint) 70%);
    box-shadow: 0 4px 14px rgba(0, 85, 164, 0.18);
  }
  .anniv-ring { position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); }
  .anniv-track { fill: none; stroke: var(--brand-tint-2); stroke-width: 4; }
  .anniv-arc { fill: none; stroke: url(#annivGrad); stroke-width: 5; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .anniv-num { position: relative; font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; line-height: 1; letter-spacing: -0.02em; color: var(--brand); font-variant-numeric: tabular-nums; }
  .anniv-label { position: relative; margin-top: 1px; font-size: 0.56rem; font-weight: 800; line-height: 1; letter-spacing: 0.14em; text-transform: uppercase; color: var(--navy-2); }
  /* light sweep */
  .anniv::after {
    content: ''; position: absolute; inset: -20%;
    background: linear-gradient(115deg, transparent 35%, rgba(255, 255, 255, 0.85) 50%, transparent 65%);
    transform: translateX(-120%); pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .anniv.is-intro .anniv-arc { animation: anniv-draw 1.3s cubic-bezier(0.16, 1, 0.3, 1) both 0.15s; }
    :global(.js) .anniv.is-intro .anniv-label { animation: anniv-fade 0.6s ease-out both 0.9s; }
    :global(.js) .anniv.is-intro { animation: anniv-pop 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both; }
    .anniv.is-shine::after { animation: anniv-shine 1.1s ease-in-out; }
    .nav-brand:hover .anniv-ring { transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1); transform: rotate(270deg); }
  }
  @keyframes anniv-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes anniv-fade { from { opacity: 0; transform: translateY(3px); } to { opacity: 1; transform: none; } }
  @keyframes anniv-pop { from { transform: scale(0.6); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  @keyframes anniv-shine { from { transform: translateX(-120%); } to { transform: translateX(120%); } }

  @media (max-width: 479px) {
    .nav-brand { gap: var(--sp-3); }
    .anniv { width: 42px; height: 42px; }
    .anniv-num { font-size: 0.95rem; }
    .anniv-label { font-size: 0.5rem; }
  }
</style>

<script>
  import { animate } from 'motion';
  // Full intro once per visit; later pages show the seal settled, with a light sweep only on hover.
  const seal = document.querySelector<HTMLElement>('[data-anniv]');
  const num = seal?.querySelector<HTMLElement>('[data-anniv-num]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (seal && num && !reduce) {
    let seen = false;
    try { seen = sessionStorage.getItem('anniv-seen') === '1'; sessionStorage.setItem('anniv-seen', '1'); } catch { /* storage unavailable */ }
    const shine = () => {
      seal.classList.remove('is-shine'); void seal.offsetWidth; seal.classList.add('is-shine');
    };
    if (!seen) {
      seal.classList.add('is-intro');
      const target = Number(num.textContent);
      num.textContent = '0';
      animate(0, target, { duration: 1.2, delay: 0.25, ease: [0.16, 1, 0.3, 1], onUpdate: (v) => { num.textContent = String(Math.round(v)); } })
        .then(() => window.setTimeout(shine, 150));
    }
    seal.closest('.nav-brand')?.addEventListener('mouseenter', shine);
  }
</script>

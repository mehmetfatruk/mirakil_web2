---
import { url, company, productsInNavOrder, services, SITE_ORIGIN } from '../lib/site';
const year = new Date().getFullYear();

// "Yapay zekâ ile özetleyin": opens the current page in AI assistants with a neutral, ready-made question.
const pageUrl = SITE_ORIGIN + (Astro.url.pathname.endsWith('404.html') ? url('index.html') : Astro.url.pathname);
const prompt = `${pageUrl} adresindeki MirAkıl Veri İşleme web sitesini özetle: Şirket ne yapıyor, hangi ürün ve hizmetleri sunuyor, hangi kurumlarla çalışmış ve öne çıkan projeleri neler?`;
const q = encodeURIComponent(prompt);
const aiLinks = [
  { name: 'ChatGPT', href: `https://chatgpt.com/?q=${q}` },
  { name: 'Claude', href: `https://claude.ai/new?q=${q}` },
  { name: 'Perplexity', href: `https://www.perplexity.ai/search?q=${q}` },
  { name: 'Google AI', href: `https://www.google.com/search?udm=50&q=${q}` },
  { name: 'Grok', href: `https://grok.com/?q=${q}` },
];
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-about">
        <h2 class="footer-title">{company.name}</h2>
        <p>{company.about}</p>
        <ul role="list" class="footer-contact">
          <li><i class="fas fa-map-marker-alt" aria-hidden="true"></i><span>{company.address}</span></li>
          <li><i class="fas fa-phone" aria-hidden="true"></i><a href={company.phoneHref}>{company.phone}</a></li>
          <li><i class="fas fa-fax" aria-hidden="true"></i><span>Faks: {company.fax}</span></li>
          <li><i class="fas fa-envelope" aria-hidden="true"></i><a href={company.emailHref}>{company.email}</a></li>
        </ul>
      </div>
      <div>
        <h2 class="footer-title">Ürünler</h2>
        <ul role="list" class="footer-links">
          {productsInNavOrder.map((p) => <li><a href={url(`${p.slug}.html`)}>{p.name}</a></li>)}
        </ul>
      </div>
      <div>
        <h2 class="footer-title">Hizmetler</h2>
        <ul role="list" class="footer-links">
          {services.map((s) => <li><a href={url('index.html#services')}>{s.title}</a></li>)}
        </ul>
      </div>
      <div>
        <h2 class="footer-title">Hızlı Erişim</h2>
        <ul role="list" class="footer-links">
          <li><a href={url('index.html')}>Ana Sayfa</a></li>
          <li><a href={url('index.html#products')}>Ürünler</a></li>
          <li><a href={url('index.html#services')}>Hizmetler</a></li>
          <li><a href={url('index.html#why-us')}>Hakkımızda</a></li>
          <li><a href={url('referanslar.html')}>Referanslar</a></li>
          <li><a href={url('index.html#faq')}>SSS</a></li>
          <li><a href={url('index.html#contact')}>İletişim</a></li>
          <li><a href={url('destek.html')}>Destek</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-ai">
      <p class="footer-ai-label"><i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i> Bu sayfayı yapay zekâ ile özetleyin</p>
      <ul role="list" class="footer-ai-links">
        {aiLinks.map((a) => (
          <li><a href={a.href} target="_blank" rel="noopener nofollow" aria-label={`Bu sayfayı ${a.name} ile özetle (yeni sekmede açılır)`}>{a.name} <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i></a></li>
        ))}
      </ul>
    </div>
    <div class="footer-bottom">
      <span>&copy; {year} {company.legalName} Tüm hakları saklıdır.</span>
    </div>
  </div>
</footer>

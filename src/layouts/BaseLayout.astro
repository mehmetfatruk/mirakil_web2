---
import '@fontsource/figtree/400.css';
import '@fontsource/figtree/500.css';
import '@fontsource/figtree/600.css';
import '@fontsource/figtree/700.css';
import '@fontsource/archivo/700.css';
import '@fontsource/archivo/800.css';
import '@fortawesome/fontawesome-free/css/all.min.css';
import '../styles/global.css';
import '../styles/components.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url, SITE_ORIGIN, company, type NavKey } from '../lib/site';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  ogTitle?: string;
  ogDescription?: string;
  /** file name used for canonical / og:url, e.g. "koha.html" */
  path: string;
  nav?: NavKey;
  /** where the nav "İletişim" link points (product pages scroll to their own CTA) */
  contactHref?: string;
  noindex?: boolean;
  chrome?: boolean;
}

const {
  title, description, keywords, ogTitle, ogDescription, path,
  nav = 'none', contactHref = 'index.html#contact', noindex = false, chrome = true,
} = Astro.props;
const canonical = SITE_ORIGIN + url(path);
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={SITE_ORIGIN + url('assets/logo.png')} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={company.name} />
    <meta name="theme-color" content="#0055a4" />
    <link rel="icon" href={url('favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" href={url('favicon-32.png')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">İçeriğe atla</a>
    {chrome && <Header active={nav} contactHref={contactHref} />}
    <main id="main">
      <slot />
    </main>
    {chrome && <Footer />}
    {chrome && (
      <a href={company.whatsappHref} target="_blank" rel="noopener" class="wa-float" aria-label="WhatsApp ile iletişime geçin" title="WhatsApp ile iletişime geçin">
        <i class="fab fa-whatsapp" aria-hidden="true"></i>
      </a>
    )}
    <script>
      import '../scripts/site';
    </script>
    <slot name="scripts" />
  </body>
</html>
